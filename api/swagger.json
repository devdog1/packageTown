{
  "openapi": "3.0.0",
  "info": {
    "title": "Network Infrastructure Management API",
    "version": "1.0.0",
    "description": "API for managing towns, nodes, packages, and profiles."
  },
  "paths": {
    "/api/towns.php": {
      "get": {
        "summary": "List all towns or get a specific town",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Geographic Area of the town",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of towns or a single town",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Town" } },
                    { "$ref": "#/components/schemas/Town" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new town",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Town" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "summary": "Update a town",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Town" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "summary": "Delete a town",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/nodes.php": {
      "get": {
        "summary": "List all nodes or get a specific node",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Node" } },
                    { "$ref": "#/components/schemas/Node" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new node",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Node" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "summary": "Update a node",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Node" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "summary": "Delete a node",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/packages.php": {
      "get": {
        "summary": "List all speed packages",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Package" } },
                    { "$ref": "#/components/schemas/Package" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new package",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Package" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "summary": "Update a package",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Package" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "summary": "Delete a package",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/profiles.php": {
      "get": {
        "summary": "List all profiles",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } },
                    { "$ref": "#/components/schemas/Profile" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Profile" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "summary": "Update a profile",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Profile" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "summary": "Delete a profile",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/mappings.php": {
      "get": {
        "summary": "List mappings",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["node_profile", "profile_package"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "post": {
        "summary": "Create a mapping",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["node_profile", "profile_package"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Town": {
        "type": "object",
        "properties": {
          "Geographic Area": { "type": "string" },
          "2LA": { "type": "string" },
          "3LA": { "type": "string" },
          "CLLI": { "type": "string" },
          "Location": { "type": "string" }
        }
      },
      "Node": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "node_pon_id": { "type": "string" },
          "node_pon_name": { "type": "string" },
          "type": { "type": "string", "enum": ["docsis", "fiber"] }
        }
      },
      "Package": {
        "type": "object",
        "properties": {
          "State": { "type": "string" },
          "Current Plan": { "type": "string" },
          "CSG CODE": { "type": "string" },
          "Download Speed": { "type": "string" },
          "Upload Speed": { "type": "string" },
          "Provisioning System Name": { "type": "string" }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "profile_id": { "type": "string" },
          "profile_name": { "type": "string" }
        }
      }
    }
  }
}
